# Identifiants de votre compte TP-Link (ceux de l'appli Tapo)
# Ils servent uniquement à l'authentification LOCALE avec la prise,
# aucune requête n'est envoyée au cloud TP-Link après coup.
TAPO_EMAIL=votre.email@example.com
TAPO_PASSWORD=votre_mot_de_passe

# Chaîne de connexion PostgreSQL
# - Si vous lancez collector.py via Docker Compose : laissez "postgres" (nom du service)
# - Si vous lancez collector.py directement sur votre machine (hors Docker) : remplacez par "localhost"
PG_DSN=postgresql://tapo:tapo_password@postgres:5432/tapo

# Liste des prises : nom=adresse_ip séparés par des virgules
# Trouvez l'IP de chaque prise dans l'appli Tapo (Paramètres de l'appareil)
# ou dans l'interface de votre box/routeur.
TAPO_DEVICES=salon=192.168.1.50,bureau=192.168.1.51

# Connexion pgAdmin (ou tout autre client SQL en local : DBeaver, TablePlus...)
# Le conteneur postgres publie son port sur votre machine (voir docker-compose.yaml),
# ces valeurs ne sont pas lues par l'application, elles servent juste de
# pense-bête pour configurer un serveur dans pgAdmin (Register > Server...).
PGADMIN_PG_HOST=localhost
PGADMIN_PG_PORT=5432
PGADMIN_PG_DB=tapo
PGADMIN_PG_USER=tapo
PGADMIN_PG_PASSWORD=tapo_password
